# ---------------------------------------------------------------------------
# NOTHING IS CACHED.
#
# Stale content caused repeated blank screens and missing images, so caching is
# switched off outright rather than tuned. `no-store` is stronger than
# `no-cache`: no-cache lets a browser keep a copy and revalidate, while
# no-store forbids writing the response down at all.
#
# The cost is real and accepted: every visit re-downloads the JS/CSS bundles
# and fonts instead of reusing them. If the bandwidth becomes a problem later,
# the safe thing to re-enable is ONLY /assets/* — those filenames contain a
# content hash, so a changed file always arrives at a new URL and can never go
# stale. The un-hashed entry points (index.html, sw.js, the manifest) must stay
# uncached whatever happens; a stale index.html is what pointed the app at
# bundles that no longer existed.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"

  # A conditional request can still yield a 304 "unchanged" and let the browser
  # reuse what it has. Dropping the validators forces a full response.
  Header unset ETag
  Header unset Last-Modified
</IfModule>

FileETag None

<IfModule mod_expires.c>
  # Overrides any inherited ExpiresDefault from the server config.
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# SPA fallback: real files are served as-is, everything else renders index.html
# so client-side routes survive a direct hit or a refresh.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
