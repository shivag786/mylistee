# ---------------------------------------------------------------------------
# Cache policy FIRST -- it is the difference between a working visit and the
# blank screen that only a hard refresh clears.
#
# Without an explicit Cache-Control, Apache sends just Last-Modified/ETag and
# browsers fall back to HEURISTIC caching: they invent a freshness lifetime and
# reuse index.html without asking the server. That stale index.html still
# references the previous build's hashed bundles, which the next build deleted,
# so the module fetch 404s and nothing renders.
#
# The rule: the entry points must always revalidate, the hashed assets never
# need to.
# ---------------------------------------------------------------------------

<IfModule mod_setenvif.c>
  # Everything under /assets/ carries a content hash in its filename, so a
  # changed file always arrives under a new URL and can be cached forever.
  SetEnvIf Request_URI "^/assets/" LONG_CACHE=1
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE

  # The un-hashed entry points. `no-cache` does NOT mean "don't cache" -- it
  # means "cache, but revalidate every time", so these still return a cheap 304
  # when unchanged. Service worker scripts are here too: a stale sw.js can never
  # update itself, which strands a device on an old build indefinitely.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|firebase-messaging-sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# SPA fallback: real files are served as-is, everything else renders index.html
# so client-side routes survive a direct hit or a refresh.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
